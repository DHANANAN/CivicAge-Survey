rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isMaster() {
      return isAuthenticated() && (
        getUserRole() == 'master' || 
        request.auth.token.email in ['scscdata@gmail.com', 'scscpdata@gmail.com']
      );
    }

    function isNormalUser() {
      return isAuthenticated() && getUserRole() == 'normal';
    }

    function hasValidGeo(geo) {
      return geo != null &&
        geo.accuracy is number &&
        geo.accuracy <= 100.0 &&
        geo.timestamp is number &&
        geo.timestamp > 0;
    }

    // Records Collection Rules (Records-Only Flow)
    match /records/{recordId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() &&
        hasValidGeo(request.resource.data.geo) &&
        request.resource.data.consentGiven == true &&
        request.resource.data.userId == request.auth.uid;
        
      allow update: if isMaster();
      allow delete: if isMaster();
    }

    // Legacy Instruments Collection
    match /instruments/{instrumentId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() &&
        request.resource.data.status in ['draft', 'pending_qa', 'completed'] &&
        hasValidGeo(request.resource.data.geo);

      allow update: if isMaster() || (
        isAuthenticated() && 
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.status in ['draft', 'pending_qa']
      );

      allow delete: if isMaster();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isMaster() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Telemetry and Drive Push Audit Logs
    match /telemetryLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isMaster();
    }

    match /drivePushLogs/{logId} {
      allow read: if isMaster();
      allow create: if false; // Only Cloud Functions can create audit logs
    }
  }
}
